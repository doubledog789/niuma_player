+#ifndef IJK_AVFFT_SHIM_H
+#define IJK_AVFFT_SHIM_H
+/* FFmpeg 8.0 移除了 libavcodec/avfft.h（FFT API 迁到 libavutil/tx.h）。
+ * ijkplayer 仅在音频波形可视化（SHOW_MODE_RDFT）中用到 RDFT，niuma 的
+ * 播放路径永远走不到该分支，这里提供最小 shim 让编译通过。 */
+typedef struct RDFTContext RDFTContext;
+typedef float FFTSample;
+#define av_rdft_end(ctx) do { (void)(ctx); } while (0)
+#endif
